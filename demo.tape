# go-trace TUI demo
# Prerequisites: cd example && docker compose up -d
# Usage: vhs demo.tape

Output demo.gif

Require docker

Set Shell "zsh"
Set FontSize 15
Set Width 1200
Set Height 700
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms

# Wait for traces to be generated by the client container
Sleep 2s

# Launch TUI inside the app container
Type "docker exec -it example-app-1 go-trace view"
Enter
Sleep 3s

# Navigate down
Type "j"
Sleep 600ms
Type "j"
Sleep 600ms

# Expand trace tree
Type " "
Sleep 2s

# Navigate further
Type "j"
Sleep 600ms
Type "j"
Sleep 600ms

# Expand another trace
Type " "
Sleep 2s

# Collapse it
Type " "
Sleep 1s

# Jump to bottom
Type "G"
Sleep 1.5s

# Expand the last trace
Type " "
Sleep 2s

# Jump to top
Type "g"
Sleep 1.5s

# Page down
Ctrl+D
Sleep 1.5s

# Page up
Ctrl+U
Sleep 1.5s

Sleep 1s

# Quit
Type "q"
Sleep 500ms
